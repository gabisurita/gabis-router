FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents shell/index.html shell/shell.css shell/boot.js offline-first-sw.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/router.html shell/screens/router.css shell/handlers/is_key.js shell/handlers/map_action.js shell/handlers/place_found.js shell/handlers/planner_action.js shell/handlers/route_answered.js shell/handlers/search_submitted.js shell/renderers/elevation-chart.js shell/renderers/surface-breakdown.js shell/hatches/gpx-io.js shell/units/brouter/segments/E0_N50.rd5 shell/units/brouter/segments/W10_N50.rd5 shell/units/brouter/segments/W10_N55.rd5 shell/units/brouter/segments/W15_N50.rd5 shell/units/brouter/segments/W50_S25.rd5 shell/units/brouter/segments/W5_N50.rd5 shell/units/brouter/segments/W5_N55.rd5 shell/units/brouter/segments/W5_N60.rd5 shell/units/brouter/unit.js shell/units/geocoder/unit.js shell/units/router-map/index.html shell/units/router-map/vendor/maplibre-gl.css shell/units/router-map/vendor/maplibre-gl.js shell/units/router-map/vendor/pmtiles.js messages/en.json messages/pt-BR.json brief.md brief.html journal.html ir.html ir/card.css acceptance.md DESIGN.md ir/neighbourhood-app.svg ir/neighbourhood-router.svg journal/2026-11-11-oracle-street-routing-and-waypoint-editing.png journal/2026-11-11-sprint-1-london-route.png journal/2026-11-11-sprint-2-slot-comparison.png journal/2026-11-11-sprint-3-custom-brf-studio.png journal/2026-11-11-sprint-4-offline-and-ptbr.png journal/2026-11-11-sprint-6-breakdowns-pmtiles-offline.png robots.txt sitemap.xml shell/favicon.svg ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS served_srcs
COPY --from=served_ctxs /monorepo /monorepo

