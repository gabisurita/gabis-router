{
  "name": "gabis-router-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build -p rsrouter-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/pkg ../target/wasm32-unknown-unknown/release/rsrouter_wasm.wasm",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/**/*.test.ts",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.3.0",
    "@capacitor/core": "^7.4.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "react": "^0.0.0-experimental-e9db3cc2-20250501",
    "react-dom": "^0.0.0-experimental-e9db3cc2-20250501"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
